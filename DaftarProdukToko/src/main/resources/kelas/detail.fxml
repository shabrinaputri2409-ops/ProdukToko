<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="kelas.controller.DetailController"
            stylesheets="@styles/app.css">

    <top>
        <HBox spacing="15" styleClass="header">

            <VBox spacing="5" HBox.hgrow="ALWAYS">
                <Label text="♡ My Little Store"
                       styleClass="title"/>

                <Label text="Informasi lengkap produk"
                       styleClass="muted"/>
            </VBox>

            <Button text="Kembali ke Daftar"
                    onAction="#bukaDaftar"/>
        </HBox>
    </top>

    <center>
        <VBox alignment="CENTER"
              styleClass="page">

            <VBox spacing="18"
                  maxWidth="480"
                  styleClass="card">

                <Label text="Detail Produk ♡"
                       styleClass="title"/>

                <Label text="Kode Produk"
                       styleClass="muted"/>

                <Label fx:id="kodeLabel"
                       styleClass="subtitle"/>

                <Separator/>

                <Label text="Nama Produk"
                       styleClass="muted"/>

                <Label fx:id="namaLabel"
                       styleClass="subtitle"/>

                <Separator/>

                <Label text="Kategori"
                       styleClass="muted"/>

                <Label fx:id="kategoriLabel"
                       styleClass="subtitle"/>

                <Separator/>

                <Label text="Harga Produk"
                       styleClass="muted"/>

                <Label fx:id="hargaLabel"
                       styleClass="title"/>

                <Button text="♡ Tambah Produk Lain"
                        onAction="#tambahLagi"
                        styleClass="button-primary"
                        maxWidth="Infinity"/>

            </VBox>
        </VBox>
    </center>

</BorderPane>