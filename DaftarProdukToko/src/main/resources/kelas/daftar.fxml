<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="kelas.controller.DaftarController"
            stylesheets="@styles/app.css">

    <top>
        <VBox spacing="12" styleClass="header">

            <Label text="Daftar Produk Toko"
                   styleClass="title"/>

            <TextField fx:id="cariField"
                       promptText="Cari nama produk..."
                       onAction="#cari"/>

            <FlowPane hgap="10" vgap="8">

                <Button text="Cari"
                        onAction="#cari"/>

                <Button text="Tampilkan Semua"
                        onAction="#tampilkanSemua"/>

                <Button text="Tambah Produk"
                        onAction="#tambah"/>

                <Button text="Lihat Detail"
                        onAction="#detail"/>

            </FlowPane>
        </VBox>
    </top>

    <center>
        <TableView fx:id="tabel">

            <columns>

                <TableColumn fx:id="kodeCol"
                             text="Kode Produk"
                             prefWidth="150"/>

                <TableColumn fx:id="namaCol"
                             text="Nama Produk"
                             prefWidth="250"/>

                <TableColumn fx:id="kategoriCol"
                             text="Kategori"
                             prefWidth="150"/>

                <TableColumn fx:id="hargaCol"
                             text="Harga (Rp)"
                             prefWidth="180"/>

            </columns>

        </TableView>
    </center>

    <bottom>
        <Label fx:id="pesanLabel"/>
    </bottom>

</BorderPane>
